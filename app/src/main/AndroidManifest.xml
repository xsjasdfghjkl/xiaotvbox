<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限清单说明（这是本项目最重要的安全声明之一）：

      本应用只申请 INTERNET 一个权限。
      没有 READ_PHONE_STATE / ACCESS_FINE_LOCATION / READ_CONTACTS / 录音 / 摄像头 /
      READ_EXTERNAL_STORAGE / QUERY_ALL_PACKAGES / REQUEST_INSTALL_PACKAGES 等任何权限。

      其中 REQUEST_INSTALL_PACKAGES 与动态加载 dex/jar 是同类 TVBox 最常见的两条灰色能力，
      本项目一条都没有：不能静默装 APK，也不能从网络加载可执行代码。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeTVBox"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:launchMode="singleTask"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SearchActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="landscape" />
    </application>

</manifest>
